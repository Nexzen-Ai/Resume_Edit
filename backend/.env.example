SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini/gemini-2.0-flash-lite
# Vision model for reading JD screenshots (must support image input)
VISION_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
JWT_SECRET=your-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600

# Optional overrides
DAILY_EDIT_LIMIT=5
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email verification
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# SMTP (leave blank in dev — verification link is logged to the console instead)
# For Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com, password=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
